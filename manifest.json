{
  "manifest_version": 3,
  "name": "Clean Ears \u2013 YouTube Profanity Filter",
  "version": "1.16.2",
  "description": "Delays YouTube a couple of seconds, transcribes the audio locally with Whisper, and bleeps or silences the swear words you choose.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clean Ears",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lookahead/webm-opus-demuxer.js",
        "lookahead/opus-pcm-decoder.js",
        "lookahead/mse-tap.js",
        "lookahead/main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "filter.js",
        "lookahead/pcm-timeline.js",
        "lookahead/word-timeline.js",
        "lookahead/lookahead-transcriber.js",
        "lookahead/clock-sync.js",
        "lookahead/transcript-cache.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "capture-worklet.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
